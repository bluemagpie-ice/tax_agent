# ========================================
# LLM 配置（当前用智谱 GLM）
# ========================================
LLM_PROVIDER=GLM
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_ID=glm-4.7-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 请求前上下文预算；默认保守值，切换模型时按该模型实际窗口调整（不自动猜容量）。
LLM_CONTEXT_WINDOW=8192
LLM_MAX_OUTPUT_TOKENS=1536
LLM_CONTEXT_WARN_RATIO=0.8

# ========================================
# Embedding 配置（当前用 SiliconFlow）
# ========================================
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_ID=BAAI/bge-large-zh-v1.5
VECTOR_SIZE=1024

# ========================================
# Qdrant 向量数据库
# ========================================
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_CLUSTER_URL=https://your-cluster.qdrant.io

# ========================================
# 本地 SQLite（可选，默认值即可）
# ========================================
# DATABASE_URL=sqlite:///E:/path/to/tax_agent.db

# 为两个身份和会话签发分别生成独立强随机值（Python secrets.token_urlsafe(32)）。
AUTH_USER_TOKEN=
DEVELOPER_TOKEN=
AUTH_SESSION_SECRET=
# 启动地址/端口通过 uvicorn --host / --port 指定，避免在代码中固定。
# 联网搜索不需要 API Key；默认 Bing 地址，可按网络环境覆盖。
WEB_SEARCH_URL=https://cn.bing.com/search

# ========================================
# Neo4j 图数据库（可选，未安装则跳过）
# ========================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j
# NEO4J_CONNECT_TIMEOUT=3

# ========================================
# Deepseek 备选（可选）
# ========================================
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_ID=deepseek-v4-flash

# 仅允许受信前端来源；默认同机 8000 端口。
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 本地模型/Embedding/Qdrant 需显式允许 origin，多个用逗号分隔。
# TAX_AGENT_MODEL_ALLOWED_ORIGINS=http://localhost:11434,http://localhost:6333

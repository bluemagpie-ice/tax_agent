# ========================================
# LLM 配置（当前用智谱 GLM）
# ========================================
LLM_PROVIDER=GLM
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_ID=glm-4.7-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ========================================
# Embedding 配置（当前用 SiliconFlow）
# ========================================
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_ID=BAAI/bge-large-zh-v1.5
VECTOR_SIZE=1024

# ========================================
# Qdrant 向量数据库
# ========================================
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_CLUSTER_URL=https://your-cluster.qdrant.io

# ========================================
# 本地 SQLite（可选，默认值即可）
# ========================================
DATABASE_URL=sqlite:///./tax_agent.db

# 本地演示鉴权；修改后在首页模型配置弹窗填写对应访问 Token。
AUTH_USER_TOKEN=test_token_123
DEVELOPER_TOKEN=admin_token_456
# 启动地址/端口通过 uvicorn --host / --port 指定，避免在代码中固定。
# 联网搜索不需要 API Key；默认 Bing 地址，可按网络环境覆盖。
WEB_SEARCH_URL=https://cn.bing.com/search

# ========================================
# Neo4j 图数据库（可选，未安装则跳过）
# ========================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j
# NEO4J_CONNECT_TIMEOUT=3

# ========================================
# Deepseek 备选（可选）
# ========================================
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_ID=deepseek-v4-flash

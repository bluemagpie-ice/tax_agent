# ========================================
# 敏感凭证 —— 绝对不能提交
# ========================================
.env
.env.*
!.env.example
!.env.*.example
!.env.template
/secrets/
*.key
*.p12
*.pfx

# ========================================
# Python 环境
# ========================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
/build/
/dist/

# ========================================
# LangGraph 持久化数据（checkpoint 数据库）
# ========================================
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*.db-journal

# ========================================
# 知识库 / 上传文件
# ========================================
/data/
/uploads/
/eval/research/config.json
/.paddlex/
/.paddleocr/

# ========================================
# 日志
# ========================================
*.log
*.jsonl
logs/

# ========================================
# 调试 / MCP 追踪
# ========================================
.statamcp/
/premium-audit.json

# ========================================
# IDE
# ========================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# ========================================
# 测试 / 缓存
# ========================================
.pytest_cache/
.test_runs/
.mypy_cache/
.ruff_cache/
coverage.xml
.coverage
.coverage.*
htmlcov/
# 仅允许已核验的纯文本测试样本；发票影像及其他本地样本留在本地
/tests/fixtures/*
!/tests/fixtures/test_txt.txt
!/tests/fixtures/test_csv.csv

# ========================================
# 快照备份 / 临时文件
# ========================================
_snapshot_*/
*.bak
*.tmp
